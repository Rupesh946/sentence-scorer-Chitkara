# Required environment variables for the backend
# Copy this file to .env and fill in the values.

# Your Groq API key — get one at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# (Production only) The URL of your deployed frontend, e.g.:
# ALLOWED_ORIGIN=https://your-app.vercel.app
ALLOWED_ORIGIN=*

# (Production only) Writable path for the SQLite DB on Vercel serverless.
# Set this to /tmp/blooms.db in your Vercel environment variables.
# DB_PATH=/tmp/blooms.db
